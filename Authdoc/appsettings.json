{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=Authdoc;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "Authdoc",
    "Audience": "Users",
    "ExpirationInMinutes": 60,
    "RefreshTokenExpirationInDays": 7,
    "RefreshTokenReuseGraceSeconds": 10
  },
  "FORWARDEDHEADERS_ENABLED": "true",
  "RateLimiting": {
    "LoginPermitLimit": 5,
    "RefreshPermitLimit": 30,
    "RegisterPermitLimit": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
